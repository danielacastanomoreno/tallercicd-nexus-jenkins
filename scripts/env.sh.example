# ---------------------------------------------------------------------------
# Copie este archivo a scripts/env.sh (esta en .gitignore) y ajuste NEXUS_URL.
# Cargue las variables en su terminal con:   source scripts/env.sh
# La contrasena NUNCA se guarda en disco ni se pega en herramientas de IAG.
# ---------------------------------------------------------------------------
export NEXUS_URL="http://<IP-DE-NEXUS>:8081"     # laptop: IP publica | ec2-deploy: IP privada
export NEXUS_USER="ci-publisher"                 # en ec2-deploy use: deploy-reader
read -rsp "Password de ${NEXUS_USER}: " NEXUS_PASS; echo
export NEXUS_PASS
