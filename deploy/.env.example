# ---- Configuracion del entorno (Factor III): lo UNICO que cambia entre releases ----
APP_VERSION=1.0.0

# Imagenes de runtime fijadas por DIGEST (no por etiqueta flotante). Obtenga cada digest con:
#   docker pull eclipse-temurin:17-jre-alpine
#   docker inspect --format '{{index .RepoDigests 0}}' eclipse-temurin:17-jre-alpine
# y reemplace REEMPLACE_DIGEST por el hash sha256:... resultante.
JRE_IMAGE=eclipse-temurin:17-jre-alpine@sha256:REEMPLACE_DIGEST
NGINX_IMAGE=nginx:1.27-alpine@sha256:REEMPLACE_DIGEST
